abstract_target 'Common' do
  pod 'OpenTelemetry-Swift-Api', '2.5.0'
  pod 'AtatusInternal', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusCore', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusLogs', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusTrace', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusRUM', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusCore', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusSessionReplay', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusCrashReporting', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusFlags', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE
  pod 'AtatusProfiling', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE

  target 'App Dynamic iOS' do
    platform :ios, '13.0'
    use_frameworks!
    pod 'AtatusWebViewTracking', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE

    target 'App Dynamic iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static iOS' do
    platform :ios, '13.0'
    pod 'AtatusWebViewTracking', :git => 'https://github.com/Atatus/atatus-sdk-ios.git', :GIT_REFERENCE

    target 'App Static iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Dynamic tvOS' do
    platform :tvos, '13.0'
    use_frameworks!

    target 'App Dynamic tvOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static tvOS' do
    platform :tvos, '13.0'

    target 'App Static tvOS Tests' do
      inherit! :search_paths
    end
  end

end
